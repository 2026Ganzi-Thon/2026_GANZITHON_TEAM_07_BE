# 로컬 개발용 예시입니다. 복사 후 비밀번호를 바꾸세요.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ganzithon
DB_USERNAME=ganzithon
DB_PASSWORD=change_me_local_app
MYSQL_ROOT_PASSWORD=change_me_local_root
API_DOCS_ENABLED=true

# Base64-encoded random key, at least 32 decoded bytes (generate with: openssl rand -base64 32)
AUTH_JWT_SECRET=

# OAuth2 provider credentials and the exact registered redirect URI used by each client
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LLM 제공자 및 모델은 추후 결정합니다.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

#!/bin/sh
set -eu

deny() {
    printf '%s\n' "Push blocked: $1" >&2
    printf '%s\n' 'Push a task branch to the team repository (origin), then open a PR into main.' >&2
    exit 1
}

[ "${1-}" = origin ] || deny 'Use the team remote origin.'
origin_url=$(git remote get-url --push --all origin) || deny 'Cannot resolve origin.'
[ "${2-}" = "$origin_url" ] || deny 'Push URL must match the single origin push URL.'

url=$(printf '%s' "$origin_url" | LC_ALL=C tr '[:upper:]' '[:lower:]')
case "$url" in
    https://github.com/*) repo_path=${url#https://github.com/} ;;
    git@github.com:*) repo_path=${url#git@github.com:} ;;
    ssh://git@github.com/*) repo_path=${url#ssh://git@github.com/} ;;
    *) deny 'Origin must use the team GitHub HTTPS or SSH URL.' ;;
esac
repo_path=${repo_path%/}
repo_path=${repo_path%.git}
[ "$repo_path" = 2026ganzi-thon/2026_ganzithon_team_07_be ] || deny 'Origin must point to the team repository.'

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_ref" in
        refs/heads/main) deny 'Pushing local main is forbidden.' ;;
        refs/heads/*) ;;
        *) deny 'Only task branches may be pushed; tags and deletions are blocked.' ;;
    esac
    case "$remote_ref" in
        refs/heads/main) deny 'Updating remote main is forbidden; use a PR.' ;;
        refs/heads/*) ;;
        *) deny 'Only remote task branches may be updated.' ;;
    esac
done
